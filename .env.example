# PostgreSQL (local)
DATABASE_URL="postgresql://production:production@localhost:5432/production_manager?schema=public"

# Vercel + Neon: use the pooled connection string (hostname contains -pooler).
# Prisma uses the Neon serverless adapter when the host is neon.tech.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Migrations/CLI still need a direct (non-pooler) URL in your deploy/migrate environment.

# Auth.js / NextAuth — generate a long random string
AUTH_SECRET="replace-with-a-long-random-secret"

# AUTH_URL — LOCAL DEVELOPMENT ONLY.
# On Vercel (production/preview), do NOT set AUTH_URL. Auth.js reads trustHost=true
# and auto-detects the URL from the incoming request. Pointing AUTH_URL at
# http://localhost:3000 in production causes cookie domain/CSRF mismatches that
# silently break credential login on HTTPS and contribute to redirect loops.
AUTH_URL="http://localhost:3000"

# Optional: override log level (debug | info | warn | error)
LOG_LEVEL="info"
NODE_ENV="development"
